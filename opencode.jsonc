{
  "$schema": "https://opencode.ai/config.json",
  // OpenCode Configuration with Xemoz REST API as AI Engine
  // API: GET https://api-xemoz-official.my.id/api/ai/{model}.php?pesan={message}

  "provider": {
    "xemoz-rest": {
      "name": "Xemoz AI",
      "npm": "xemoz-rest",
      "options": {
        "baseURL": "https://api-xemoz-official.my.id/api/ai",
        "model": "gpt-5.5",
        // Diturunkan dari 60000 -> 20000. Kalau server Xemoz lambat/down,
        // CLI gagal cepat alih-alih terasa "ngestuk" sampai 1 menit.
        "timeout": 20000,
        // Cuma kirim 6 giliran terakhir (bukan seluruh histori chat) supaya
        // URL request tidak membengkak seiring panjangnya percakapan.
        "maxHistoryTurns": 6,
        // Batas aman panjang pesan (karakter) sebelum dipotong, biar hampir
        // selalu berhasil di percobaan pertama tanpa retry-truncate.
        "maxMessageLength": 1400,
        // Simulasi streaming: balasan dikirim ke CLI per-24-karakter dengan
        // jeda 12ms, supaya terasa "mengetik" alih-alih diam lalu muncul
        // sekaligus. Set streamChunkSize ke 0 untuk kirim sekaligus (lama).
        "streamChunkSize": 24,
        "streamChunkDelayMs": 12
      },
      "models": {
        "gpt-5.5": {
          "name": "GPT-5.5",
          "id": "gpt-5.5",
          "family": "gpt",
          "release_date": "2025-01-01",
          "attachment": false,
          "reasoning": false,
          "temperature": false,
          "tool_call": false,
          "cost": {
            "input": 0,
            "output": 0,
            "cache_read": 0,
            "cache_write": 0
          },
          "limit": {
            "context": 128000,
            "output": 4096
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        }
      }
    }
  },

  // Use xemoz-rest as default provider
  "model": "xemoz-rest/gpt-5.5",

  // Disable all other providers
  "enabled_providers": ["xemoz-rest"]
}
